#!/usr/bin/bash

set -a -e -o pipefail -u

read -p 'Enter Password: ' -r PASSWD

DISK0="$(realpath '/dev/disk/by-id/nvme-nvme.1e4b-30303335363230303030303532-4e452d3154422032323432-00000001')"
DISK1="$(realpath '/dev/disk/by-id/nvme-eui.e8238fa6bf530001001b448b47f32f0c')"
POOLP0="${DISK0}p2"
POOLP1="${DISK1}p1"
BOOT="${DISK0}p1"
POOL="/dev/md/pool"
ROOT="/dev/mapper/root"

genUUID() {
	UUID="$(< /proc/sys/kernel/random/uuid)"
	UUID="${1}${UUID:2}"
	printf '%s\n' "${UUID}"
}

genID() {
	ID="$(< /proc/sys/kernel/random/uuid)"
	ID="b7${ID:0:6}"
	printf '%s\n' "${ID}"
}

wait_sanitize() {
	local DEV="$1"

	while true; do
		local SANITIZE_STATUS
		SANITIZE_STATUS="$(nvme log sanitize "${DEV}" | grep 'SSTAT' | awk -F ':' '{print $2}' | tr -d '[:space:]' 2>/dev/null)"

		if [[ "${SANITIZE_STATUS}" == '0x101' ]]; then
			printf '%s\n' "Sanitization of disk ${DEV} completed."
			break
		fi
	done
}

[ -e "${POOL}" ] && mdadm --stop "${POOL}" || true

nvme sanitize "${DISK0%n*}" -a 0x02
nvme sanitize "${DISK1%n*}" -a 0x02

wait_sanitize "${DISK0%n*}"
wait_sanitize "${DISK1%n*}"

partprobe "${DISK0}"
partprobe "${DISK1}"

sgdisk -U "$(genUUID 'd5')" -I -n 1:0:+1G -t 1:ef00 -c 1:'BOOT' -u 1:"$(genUUID 'd9')" -N 2 -t 2:'fd00' -c 2:'poolp0' -u 2:"$(genUUID 'd9')" "${DISK0}"
sgdisk -U "$(genUUID 'd5')" -I -N 1 -t 1:'fd00' -c 1:'poolp1' -u 1:"$(genUUID 'd9')" "${DISK1}"

mkfs.fat -I -F 32 -i "$(genID)" -n 'BOOT' "${BOOT}"

mdadm -C "${POOL}" -f --homehost=any -c 512 -l raid0 -n 2 "${POOLP0}" "${POOLP1}"

printf '%s\n' "${PASSWD}" | cryptsetup luksFormat --label 'root' --uuid "$(genUUID 'ec')" -q "${POOL}"

printf '%s\n' "${PASSWD}" | cryptsetup open --allow-discards --persistent "${POOL}" root

mkfs.btrfs -f -L 'root' -d single -m single -U "$(genUUID 'bf')" "${ROOT}"

mount -o 'compress=zstd' "${ROOT}" /mnt
btrfs subvolume create /mnt/@ /mnt/@var /mnt/@home /mnt/@snapshots
umount /mnt

mount -o 'compress=zstd,subvol=/@' "${ROOT}" /mnt
mount -m -o 'compress=zstd,subvol=/@var' "${ROOT}" /mnt/var
mount -m -o 'compress=zstd,subvol=/@home' "${ROOT}" /mnt/home
mount -m -o 'compress=zstd,subvol=/@snapshots' "${ROOT}" /mnt/.snapshots
mount -m -o 'nosuid,nodev,noexec,nosymfollow,fmask=0177,dmask=0077' "${BOOT}" /mnt/boot

chattr +C /mnt/var

pacstrap -C /root/perfect/pacman.d/pacman.conf -K -M /mnt base iptables mkinitcpio alhp-keyring cachyos-keyring chaotic-keyring

genfstab -U /mnt | tee -a /mnt/etc/fstab

mdadm -D -s | tee -a /mnt/etc/mdadm.conf

rm -f -r /mnt/etc/pacman.d/
cp -r /root/perfect/pacman.d/ /mnt/etc/
sed -i -e 's/root\/perfect/etc/g' /mnt/etc/pacman.d/pacman.conf
mv /mnt/etc/pacman.d/pacman.conf /mnt/etc/

install -m 0777 /root/perfect/perfect_install /mnt/usr/local/bin/
install -m 0777 /root/perfect/perfect_setup /mnt/usr/local/bin/
install -m 0777 /root/perfect/snapshot_sdboot /mnt/usr/local/bin/
install -m 0777 /root/perfect/git_keys_config /mnt/usr/local/bin/

cp -r /root/perfect/configs /mnt/opt/

ln -f -s /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

arch-chroot /mnt /usr/local/bin/perfect_install
arch-chroot -S -u am /mnt /usr/bin/yay -Syu --needed --noconfirm hunspell-ar otf-ibm-plex ttf-apple-emoji

rm -f /mnt/usr/local/bin/perfect_install

umount -R /mnt
cryptsetup close root
mdadm --stop "${POOL}"
systemctl poweroff --firmware-setup
