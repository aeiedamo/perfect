#!/usr/bin/bash

set -a -e -o pipefail -u

UUID="$(blkid -o value -s UUID "${ROOT}")"

sed -i -e '/^#ar_SA.UTF-8 UTF-8/s/^#//' -e '/^#en_GB.UTF-8 UTF-8/s/^#//' -e '/^#en_US.UTF-8 UTF-8/s/^#//' /etc/locale.gen
locale-gen
printf '%s\n' 'LANG=en_GB.UTF-8' | tee /etc/locale.conf

ln -f -s /usr/share/zoneinfo/Asia/Riyadh /etc/localtime
hwclock -u -w

printf '%s\n' 'KEYMAP=us' 'FONT=default8x16' | tee /etc/vconsole.conf

printf '%s\n' 'aeiedamo' | tee /etc/hostname

sed -i -e "/^#MAKEFLAGS/s/=.*$/=\"-j$(nproc)\"/" -e '/^#MAKEFLAGS/s/^#//' -e '/^OPTIONS/s/debug/!&/' /etc/makepkg.conf

sed -i -e '/^MODULES/s/(/&i915/' -e '/^HOOKS/s/systemd/& plymouth/' /etc/mkinitcpio.conf

printf '%s\n' 'options i915 enable_guc=3' | tee /etc/modprobe.d/i915.conf

systemd-hwdb update

pacman-key --init
pacman-key --populate archlinux alhp cachyos chaotic

pacman -Syyuu --needed --noconfirm linux-cachyos linux-cachyos-headers linux-cachyos-zfs linux-lts linux-lts-headers alsa-firmware alsa-utils dkms guestfs-tools intel-ucode linux-firmware linux-tools-meta mdadm plymouth scx-tools snap-pac sof-firmware wireless-regdb zfs-utils base-devel bash-completion bees devtools edk2-shell efibootmgr firejail fwupd libglvnd noto-fonts noto-fonts-cjk noto-fonts-emoji-3d noto-fonts-extra nvme-cli pipewire-alsa pipewire-jack ttf-ibmplex-mono-nerd ttf-jetbrains-mono-nerd ttf-noto-nerd zram-generator plasma-desktop plasma-login-manager plasma-nm plasma-pa qemu-full qemu-guest-agent qemu-user-static-binfmt virt-manager 7zip android-tools appmenu-gtk-module arch-wiki-docs ardour ark at bind bluedevil bluez-cups bluz-obex bluez-utils breeze5 breeze-gtk btrfs-assistant calf cdrtools chrony claude-code cloudflare-warp-bin colordiff cronie crun cryfs cups-pdf dconf-editor discord discover distrobox drkonqi dnsmasq dolphin-plugins easyeffects ebook-tools element-desktop ethtool fail2ban fastfetch fd ffmpegthumbs filelight firefox-i18n-en-gb firefox-i18n-ar firewall-applet flatpak-kcm flatpak-xdg-utils fzf gimp github-cli glab google-chrome gparted gst-plugins-bad gst-plugins-ugly gst-plugin-va gwenview haruna hunspell-en_gb inetutils intel-compute-runtime-legacy intel-gmmlib-legacy intel-graphics-compiler-legacy intel-media-sdk iwd jdk-openjdk kamoso kde-gtk-config kde-pim-meta kdeconnect kdegraphics-mobipocket kdegraphics-thumbnailers kdenetwork-filesharing kdenlive kdeplasma-addons kimageformats kinfocenter kio-admin kio-extras kio-fuse kio-gdrive kio-snapshot kio-zeroconf kitty kmscon konsole krdp kscreen ksshaskpass kup kwallet-pam kwalletmanager kwayland-integration kwrited lib32-vulkan-intel libappindicator libayatana-appindicator libreoffice-fresh-ar libreoffice-fresh-en-gb lsp-plugins-lv2 malcontent man-db mda.lv2 namcap net-tools networkmanager-l2tp networkmanager-pptp nix nm-connection-editor npm nss-mdns obsidian obs-studio okular onnxruntime-cpu openbsd-netcat orca packagekit-qt6 phonon-qt6-vlc pkgstats plasma5-integration plasma-browser-integration plasma-disks plasma-firewall plasma-keyboard plasma-systemmonitor plasma-thunderbolt plasma-vault plymouth-kcm podman-compose print-manager proton-cachyos-slr proton-vpn-cli proton-vpn-gtk-app python-pip qalculate-qt qbittorrent qt6-multimedia-gstreamer radvd ripgrep rnote rust rygel samba seahorse shellcheck-bin shelly smartmontools snapshot spectacle sshfs starship steam swtpm system-config-printer telegram-desktop tesseract-data-eng throttled tlp-pd tlp-rdw tlpui tmux traceroute trash-cli unarchiver unrar usb_modeswitch vim visual-studio-code-bin vulkan-intel vulkan-tools waydroid wdiff wget wl-clipboard yay yt-dlp zam-plugins-lv2 zip

printf '%s%s %s %s %s\n' 'root=UUID=' "${UUID}" 'rw rootflags=compress=zstd,subvol=/@' 'lsm=landlock,lockdown,yama,integrity,apparmor,bpf intel_iommu=on iommu=pt' 'quiet splash' | tee /etc/kernel/cmdline

bootctl --variables=no install
printf '%s\t%s\n' 'default' '@saved' | tee /boot/loader/loader.conf
printf '%s\t%s\n' 'title' 'CachyOS Linux' 'sort-key' '0' 'linux' '/vmlinuz-linux-cachyos' 'initrd' '/initramfs-linux-cachyos.img' 'options' "$(< /etc/kernel/cmdline)" | tee /boot/loader/entries/cachyos-linux.conf
printf '%s\t%s\n' 'title' 'Arch Linux LTS' 'sort-key' '1' 'linux' '/vmlinuz-linux-lts' 'initrd' '/initramfs-linux-lts.img' 'options' "$(< /etc/kernel/cmdline)" | tee /boot/loader/entries/arch-linux-lts.conf

cp /usr/share/edk2-shell/x64/Shell_Full.efi /boot/shellx64.efi

printf '%s\n' "UUID=${UUID}" 'DB_SIZE=1073741824' | tee /etc/bees/beesd_root.conf

printf '%s\n' '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' | tee /etc/sudoers.d/00-wheel

printf '%s\n' 'polkit.addRule(function(action, subject) { if (subject.isInGroup("wheel")) { return polkit.Result.YES; }});' | tee /etc/polkit-1/rules.d/00-wheel.rules

printf '%s\n' "${PASSWD}" "${PASSWD}" | passwd root

useradd -c 'AlaEldin Mohamed' -G audio,disk,kvm,libvirt,log,storage,wheel -m -s /usr/bin/bash am
printf '%s\n' "${PASSWD}" "${PASSWD}" | passwd am

sed -i -e '/^#WIRELESS_REGDOM="SA"/s/^#//' /etc/conf.d/wireless-regdom

printf '%s\n' 'options psmouse synaptics_intertouch=1' | tee /etc/modprobe.d/psmouse.conf

printf '%s\n' '[zram0]' 'zram-size=ram' 'compression-algorithm=zstd' | tee /etc/systemd/zram-generator.conf

mkdir -p /etc/systemd/logind.conf.d/
printf '%s\n' '[Login]' 'HandleLidSwitch=ignore' 'HandleLidSwitchExternalPower=ignore' | tee /etc/systemd/logind.conf.d/00-lid.conf

sed -i -e '/^#MulticastDNS/s/yes/resolve/' -e '/^#MulticastDNS/s/^#//' /etc/systemd/resolved.conf

printf '%s\n' 'ListenAddress aeiedamo.local' | tee /etc/ssh/sshd_config.d/00-local.conf

printf '%s\n' '[sshd]' 'enabled = true' | tee /etc/fail2ban/jail.d/00-sshd.conf

printf '%s\n' "export EDITOR='vim' VISUAL='vim'" | tee /etc/profile.d/00-editor.sh

printf '%s\n' 'export XDG_CONFIG_HOME="${HOME}/.config" XDG_CACHE_HOME="${HOME}/.cache" XDG_DATA_HOME="${HOME}/.local/share" XDG_STATE_HOME="${HOME}/.local/state" PATH="${HOME}/.local/bin:${PATH}"' | tee /etc/profile.d/01-xdg.sh

printf '%s\n' '' 'export HISTSIZE=' 'export HISTFILESIZE=' 'export HISTTIMEFORMAT="[%F %T] "' | tee -a /etc/bash.bashrc

cp /etc/skel/.bash_profile /root/
cp /etc/skel/.bashrc /root/
mkdir -p /root/.cache /root/.config /root/.local/bin /root/.local/share /root/.local/state

git clone 'https://gitlab.com/aeiedamo/perfect.git' /root/perfect
printf '%s\n' 'export PATH="/root/perfect:${PATH}"' | tee /etc/profile.d/zz-perfect.sh

sed -i -e '/^PS1\b/d' /root/.bashrc
printf '%s\n' "PS1=' \[\e[92;1;4m\]⇐ \A | \u | \w | \$? ⇒\[\e[0m\] '" 'eval "$(starship init bash)"' | tee -a /root/.bashrc

starship preset gruvbox-rainbow -o /root/.config/starship.toml

printf '%s\n' '"\e[A": history-search-backward' '"\e[B": history-search-forward' '' 'set bell-style none' 'set echo-control-characters off' 'set show-all-if-ambiguous on' 'set colored-stats on' 'set visible-stats on' 'set mark-symlinked-directories on' 'set completion-ignore-case on' 'set completion-map-case on' 'set colored-completion-prefix on' 'set menu-complete-display-prefix on' 'set revert-all-at-newline on' '$if Bash' 'Tab: menu-complete' '$endif' | tee -a /root/.inputrc

printf '%s\n' '[uefi_capsule]' 'DisableShimForSecureBoot=true' | tee -a /etc/fwupd/fwupd.conf

sed -i -e '/^hosts/s/myhostname //' -e '/^hosts/s/resolve \[\!UNAVAIL=return\]/myhostname mdns_minimal \[NOTFOUND=return\] &/' -e '/^hosts/s/$/& libvirt libvirt_guest/' /etc/nsswitch.conf

sed -i -e '/^DefaultZone/s/=.*$/=trusted/' /etc/firewalld/firewalld.conf

printf '%s\n' '[main]' 'dns=systemd-resolved' | tee /etc/NetworkManager/conf.d/00-dns.conf

mv /opt/configs/fonts/local.conf /etc/fonts/

printf '%s\n' '[UPower]' 'PercentageLow=20.0' 'PercentageCritical=10.0' 'PercentageAction=5.0' | tee /etc/UPower/UPower.conf.d/00-upower-percentage.conf
printf '%s\n' '[UPower]' 'AllowRiskyCriticalPowerAction=true' 'CriticalPowerAction=Suspend' | tee /etc/UPower/UPower.conf.d/01-upower-action.conf

mv /opt/configs/tlp.d/00-main.conf /etc/tlp.d/

mkdir -p /etc/X11/xorg.conf.d
printf '%s\n\t%s\n\t%s\n\t%s\n\t%s\n\t%s\n\t%s\n%s\n' 'Section "InputClass"' 'Identifier "system-keyboard"' 'MatchIsKeyboard "on"' 'Option "XkbLayout" "us,ara"' 'Option "XkbModel" "pc104"' 'Option "XkbVariant" ","' 'Option "XkbOptions" "grp:win_space_toggle"' 'EndSection' | tee /etc/X11/xorg.conf.d/00-keyboard.conf

mv /opt/configs/kmscon/kmscon.conf /etc/kmscon/

mv /opt/configs/xdg/mimeapps.list /etc/xdg/

printf '%s\n' '[User]' 'Session=plasma' 'Icon=/var/lib/AccountsService/icons/am' 'SystemAccount=false' | tee /var/lib/AccountsService/users/am
mv /opt/configs/pfp/am /var/lib/AccountsService/icons/

mkdir -p /usr/share/wallpapers/
mv /opt/configs/wallpapers/PixelArtCity /usr/share/wallpapers/

flatpak override --filesystem='xdg-config/fontconfig'

printf '%s\n' 'pref("general.config.filename", "firefox.cfg");' 'pref("general.config.obscure_value", 0);' | tee /usr/lib/firefox/defaults/pref/autoconfig.js
mv /opt/configs/firefox/firefox.cfg /usr/lib/firefox/

printf '%s\n' '--cookies-from-browser chrome -f "bv+ba/b" -S "ext" -o "${HOME}/Videos/%(webpage_url_domain)s/%(id)s-%(title)s.%(ext)s"' | tee /etc/yt-dlp.conf

systemctl disable getty@.service

systemctl enable atd.service avahi-daemon.service "beesd@${UUID}.service" bluetooth.service chronyd.service cronie.service cups.service fail2ban.service firewalld.service fstrim.timer fwupd-refresh.timer kmsconvt@.service ModemManager.service NetworkManager.service paccache.timer plasmalogin.service sshd.service systemd-boot-update.service systemd-resolved.service throttled.service tlp.service tlp-pd.service virtinterfaced.service virtlockd.service virtlogd.service virtnetworkd.service virtnodedevd.service virtnwfilterd.service virtqemud.service virtsecretd.service virtstoraged.service warp-svc.service wpa_supplicant.service

systemctl mask NetworkManager-initrd.service systemd-timesyncd.service
