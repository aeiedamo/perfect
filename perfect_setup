#!/usr/bin/bash

set -a -e -u

POOL="/dev/md/pool"

sudo systemd-cryptenroll --tpm2-device /dev/tpmrm0 --tpm2-pcrs 7 "${POOL}"

chattr +C "${XDG_DATA_HOME}/images"

sudo sed -i '/^\[root\]/,+1s/False/True/' /etc/snap-pac.ini

sudo systemctl enable snapper-boot.timer snapper-cleanup.timer snapper-timeline.timer snapshot_sdboot.service

sudo rm -f -r /opt/configs /usr/local/bin/perfect_setup
